---
import type { ExamRow, MetaData } from "../../scripts/types";

interface Props {
  exams: ExamRow[];
  meta: MetaData;
}

const { exams, meta } = Astro.props;
const jsonExams = JSON.stringify(exams).replace(/</g, "\\u003c");
const jsonMeta = JSON.stringify(meta).replace(/</g, "\\u003c");
---

<div id="exams-app" class="flex flex-col gap-4">
  <script type="application/json" id="exams-data" set:html={jsonExams}></script>
  <script type="application/json" id="exams-meta" set:html={jsonMeta}></script>

  <div class="tabs tabs-boxed justify-start w-fit" id="board-tabs"></div>
  <div class="flex flex-wrap items-center gap-2" id="level-chips"></div>

  <div class="flex flex-wrap items-center gap-3">
    <select id="subject-select" class="select select-bordered select-sm">
      <option value="">全部科目</option>
    </select>
    <input
      id="search-input"
      class="input input-bordered input-sm"
      placeholder="搜索科目 / 试卷编码"
    />
    <button id="select-visible" type="button" class="btn btn-sm btn-outline">
      全选当前结果
    </button>
    <span id="result-count" class="text-sm text-base-content/60"></span>
  </div>

  <div class="rounded-box border border-base-300 overflow-x-auto">
    <div class="max-h-[60vh] lg:max-h-[calc(100vh-360px)] overflow-y-auto">
      <table id="exam-table" class="table table-sm table-zebra w-full">
        <thead>
          <tr>
            <th class="sticky top-0 z-10 bg-base-100 border-b border-base-300">日期</th>
            <th class="sticky top-0 z-10 bg-base-100 border-b border-base-300">开考时间</th>
            <th class="sticky top-0 z-10 bg-base-100 border-b border-base-300">科目</th>
            <th class="sticky top-0 z-10 bg-base-100 border-b border-base-300">试卷编码</th>
            <th class="sticky top-0 z-10 bg-base-100 border-b border-base-300">试卷名称</th>
            <th class="sticky top-0 z-10 bg-base-100 border-b border-base-300">时长</th>
            <th class="sticky top-0 z-10 bg-base-100 border-b border-base-300">勾选</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </div>

  <div class="card bg-base-200 sticky bottom-0 z-20">
    <div class="card-body p-4 gap-2">
      <div class="flex flex-wrap items-center gap-3">
        <h3 class="font-bold">
          我的考试(<span id="selected-count">0</span>)
        </h3>
        <button id="clear-selection" type="button" class="btn btn-sm btn-ghost">
          清空勾选
        </button>
        <div class="flex-1"></div>
        <button id="export-excel" type="button" class="btn btn-primary btn-sm" disabled>
          生成 Excel
        </button>
        <span class="text-xs text-base-content/50">按考试日期排序导出 .xlsx</span>
      </div>
      <ul
        id="selected-list"
        class="flex flex-wrap gap-2 max-h-28 overflow-y-auto text-sm list-none pl-0"
      ></ul>
    </div>
  </div>
</div>
</div>

<script>
  import { initExamsApp } from "../../scripts/exams-app";
  initExamsApp();
</script>
